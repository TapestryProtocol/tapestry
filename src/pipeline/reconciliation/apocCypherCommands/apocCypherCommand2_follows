CALL apoc.periodic.iterate(
        "CALL apoc.load.json('file:///allKind3EventsStripped.json') YIELD value AS event",
        "
        MERGE (z:NostrUser {pubkey:event.pubkey})
        SET z.kind3CreatedAt=event.created_at, z.kind3EventId=event.id
        FOREACH (_ IN CASE WHEN NOT z:TapestryNode OR z.tapestryKey IS NULL OR z.tapestryKey = '{}' THEN [1] ELSE [] END |
          SET z:TapestryNode,
              z.tapestryKey = CASE WHEN z.tapestryKey IS NULL OR z.tapestryKey = '{}' THEN randomUUID() ELSE z.tapestryKey END)
        ",
        { batchSize:1000, parallel:true}
)
;