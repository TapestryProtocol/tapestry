node_modules
ui/node_modules
.git
.gitignore
.env
# Key material. Mirrors .gitignore's `**/keys/` so a file that git ignores can
# never be silently baked into an image by the `COPY . …` in Dockerfile:92.
# setup/nostr/keys/ held a plaintext relay privkey+nsec on dev machines; no
# tracked path contains a keys/ directory, so this cannot drop needed files.
**/keys/
.DS_Store
docker-compose*.yml
CODEBASE_ANALYSIS.md
public/kg/
.claude/
# The launcher has its own image. Leaving this out means a launcher change does not rebuild the brain image, which
# would restart every brain.
deploy/
# The external CLI (clients/cli/) runs on an agent's own machine, never in the instance (ADR
# graph-operations-foundation/0006 Decision 10), so a change to it leaves the image as it was.
clients/
