{
  "name": "allow-pull-request-target-for-main-source-guard",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [".github/workflows/guard-main-source.yml"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": ["pull_request_target"]
      }
    }
  ]
}
